.DS_Store

# Generated gzip app assets (built via `make app-gz`)
ESP8266/ESP-uclock/data/app/*.gz
ESP8266/ESP-uclock/data/app/**/*.gz

# Root build outputs
/build/

# Legacy / local build outputs inside the ESP project
/ESP8266/ESP-uclock/build/

# Generated release packages
*.zip

# Editor / tool caches
.vscode/
.idea/

# Compilation databases generated by local builds
compile_commands.json

# Persoenliche Claude-Code-Einstellungen und Hook-Diagnose
.claude/settings.local.json
.claude/hook-probe.log

# Screenshots der PWA-Vorschau
tools/preview/shots/

# Zugangsdaten fuer den Rollout
tools/deploy.conf

# Adresse der eigenen Uhr
tools/device.conf

# Rohabzuege des Geraets (koennen Zugangsdaten enthalten)
tools/snapshots/

# Python-Bytecode
__pycache__/
*.pyc

# Uebersetzungsprotokolle der Auszugs-Pruefstaende (enthalten absolute Pfade, L409)
tools/checks/auszug/**/cc.log
tools/checks/auszug/**/extract.log
# c46 erzeugt seine Ausschnitte und das Programm neben sich, wenn er direkt im Repo laeuft
# (14.10.2026 von einem Agenten so gestartet). In anderen Pruefstaenden sind .inc echte Quellen.
tools/checks/auszug/esp/c46/c46.bin
tools/checks/auszug/esp/c46/c46_*.inc
