# Vorlage fuer tools/device.conf — diese Datei kopieren und ausfuellen.
# tools/device.conf ist gitignored und gehoert nicht ins Repository: Die Adresse
# der eigenen Uhr ist interne Netzstruktur und hat in einem oeffentlichen Repo
# nichts verloren.
#
#   cp tools/device.conf.example tools/device.conf
#   $EDITOR tools/device.conf
#
# Alternativ ohne Datei, je Aufruf:
#   DEVICE_HOST=192.0.2.10 ./tools/smoke-device.sh
#
# Der ESP meldet sich NICHT per mDNS an. Einen mDNS-Namen fuer die Uhr gibt es also
# nicht, auch keinen mit der Endung .local. Es muss die IP sein, die der Router der Uhr gibt; am besten dort
# fest zuordnen, sonst zeigt diese Datei nach einem Lease-Wechsel ins Leere.

DEVICE_HOST=192.0.2.10

# Raspberry mit dem UART-Mitschnitt (tools/logger/). Die Vorgaben von log.sh passen
# zur Anleitung in tools/logger/README.md; nur abweichende Werte muessen hier stehen.
#LOG_HOST=wordclock-pi.local
#LOG_USER=pi
#LOG_KEY=~/.ssh/wordclock_pi

# Erwartete Update-Quelle. Der Smoketest vergleicht sie gegen das, was die Uhr
# tatsaechlich gespeichert hat.
#
# Warum das geprueft gehoert: Verliert der ESP seinen Variablenspeicher -- etwa nach
# einem eigenen Neustart, siehe BEFUNDE.md L42 -- sind Host und Pfad LEER. Der ESP
# faellt dann auf seine eingebauten Vorgaben zurueck, und die zeigen auf den Server
# des Ursprungsprojekts. Das naechste Update holte damit fremde Firmware, ohne dass
# irgendwo ein Fehler erschiene. Genau das ist am 03.10.2026 passiert.
DEVICE_UPDATE_HOST=update.example.net
DEVICE_UPDATE_PATH=release
